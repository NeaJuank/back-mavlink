# ============================================================
# Puertos del sistema (sin solapamientos):
#   PostgreSQL  → 5432
#   Backend API → 8000  (REST + WebSocket /ws/telemetry)
#   Frontend    → 4545  (mapeado desde 3000 interno)
# ============================================================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drones
DB_USER=dronix_user
DB_PASSWORD=DronixSecure2024!

# Database URL para Python (backend local conectando a Postgres en localhost)
DB_URL=postgresql://dronix_user:DronixSecure2024!@localhost:5432/drones

# MAVLink Configuration
MAVLINK_DEVICE=/dev/ttyACM0
MAVLINK_BAUD=115200

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
